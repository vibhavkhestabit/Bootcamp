import csv
import random
from collections import defaultdict
import json

# Configuration
NUM_ROWS = 20
REGIONS = ['North', 'South', 'East', 'West']
FILENAME_CSV = 'user.csv'
FILENAME_TXT = 'inference.txt'

# 1. Generate Data
data = []
for i in range(1, NUM_ROWS + 1):
    data.append({
        'user': f'User_{i}',
        'region': random.choice(REGIONS),
        'salary': random.randint(40000, 120000)
    })

# 2. Write to CSV
with open(FILENAME_CSV, 'w', newline='') as f:
    writer = csv.DictWriter(f, fieldnames=['user', 'region', 'salary'])
    writer.writeheader()
    writer.writerows(data)

print(f"Total rows in CSV: {len(data)}")

# 3. Read and Analyze
region_totals = defaultdict(int)
region_counts = defaultdict(int)

with open(FILENAME_CSV, 'r') as f:
    reader = csv.DictReader(f)
    for row in reader:
        region = row['region']
        salary = int(row['salary'])
        region_totals[region] += salary
        region_counts[region] += 1

# 4. Write Analysis
with open(FILENAME_TXT, 'w') as f:
    for region in REGIONS:
        if region_counts[region] > 0:
            avg = region_totals[region] / region_counts[region]
            output_line = f"Region: {region}, Average Salary: {avg:.2f}"
            f.write(output_line + "\n")
            print(output_line)
        else:
            print(f"Region: {region}, No data found.")


