def generate_fibonacci(limit: int) -> list:
    """Generates a list of Fibonacci numbers up to the limit."""
    if limit < 0:
        return []
    sequence = []
    a, b = 0, 1
    while a <= limit:
        sequence.append(a)
        a, b = b, a + b
    return sequence

# Test and verify
limit = 100
sequence = generate_fibonacci(limit)
print(f"Generated sequence: {sequence}")

# Verification logic
def verify_fibonacci(seq):
    if not seq:
        return True
    if len(seq) == 1:
        return seq[0] == 0
    if len(seq) == 2:
        return seq[0] == 0 and seq[1] == 1
    
    for i in range(2, len(seq)):
        if seq[i] != seq[i-1] + seq[i-2]:
            return False
    return True

is_valid = verify_fibonacci(sequence)
print(f"Is sequence valid Fibonacci? {is_valid}")
print(f"All numbers <= {limit}? {all(x <= limit for x in sequence)}")


