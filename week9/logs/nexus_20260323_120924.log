```python
from typing import List


def generate_fibonacci(limit: int) -> List[int]:
    """
    Generates a list of Fibonacci numbers up to the specified limit.

    Args:
        limit (int): The inclusive maximum value for the Fibonacci sequence.

    Returns:
        List[int]: A list containing Fibonacci numbers <= limit.
    """
    if limit < 0:
        return []

    sequence = [0, 1]
    if limit == 0:
        return [0]

    while True:
        next_val = sequence[-1] + sequence[-2]
        if next_val > limit:
            break
        sequence.append(next_val)

    return sequence


if __name__ == "__main__":
    # Demonstration block for CLI execution
    LIMIT = 100
    print(f"Fibonacci sequence up to {LIMIT}: {generate_fibonacci(LIMIT)}")
```

